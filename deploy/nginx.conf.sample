# Host nginx config for the new server. TLS is terminated here; nginx
# proxies straight to the gridpaste container published on 127.0.0.1:8010
# (see WEB_PORT in .env / docker-compose.yml). No static alias needed —
# whitenoise serves /application/ from inside the container.

server {
    server_name gridpaste.io www.gridpaste.io;

    access_log /var/log/nginx/gp.access.log;
    error_log  /var/log/nginx/gp.error.log;

    location / {
        include proxy_params;
        proxy_pass http://127.0.0.1:8010;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl;
    ssl_certificate     /etc/letsencrypt/live/gridpaste.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gridpaste.io/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = www.gridpaste.io) {
        return 301 https://$host$request_uri;
    }
    if ($host = gridpaste.io) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    server_name gridpaste.io www.gridpaste.io;
    return 404;
}
