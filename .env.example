# Copy to .env and fill in real values. Never commit .env.
#
# IMPORTANT: the old Postgres password ("fuck0ffbr0!") was hardcoded in
# homepage/settings.py and pushed to the public GitHub repo. Rotate it —
# don't just carry it forward here.

POSTGRES_DB=gridpaste
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

DJANGO_ALLOWED_HOSTS=gridpaste.io,www.gridpaste.io

# host port that nginx will proxy_pass to
WEB_PORT=8010
